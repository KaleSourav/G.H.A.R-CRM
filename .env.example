# =============================================================================
# G.H.A.R CRM — Environment Variables Template
# Copy this to .env in both /frontend and /backend, then fill in your values.
# =============================================================================

# ─── SUPABASE ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE   # Backend only — never expose to browser!

# ─── BACKEND ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=YOUR_SUPABASE_JWT_SECRET   # Found in Supabase Dashboard > Settings > API > JWT Secret

# ─── FRONTEND ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
VITE_API_BASE_URL=http://localhost:4000/api

# ─── OPTIONAL — Phase 2 integrations (leave blank for now) ──────────────────
# WHATSAPP_API_KEY=
# SMS_GATEWAY_KEY=
# SENDGRID_API_KEY=
# META_LEAD_ADS_VERIFY_TOKEN=
