{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/crm/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/crm/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/crm",
      "destination": "/index.html"
    }
  ]
}
